# Copy this file to .env and fill in your real values. .env is gitignored.

# --- CognoDB Cloud (production) ---
# From console.cognodb.com after creating your free instance:
# NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.cloud
# NEO4J_USER=cognodb
# NEO4J_PASSWORD=<the password shown once at instance creation>

# --- Local development (docker-compose Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
